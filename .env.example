# Copy this file to .env and fill in your own key. Never commit the real .env.

GROQ_API_KEY=your_groq_api_key_here

# Model used for categorization / contradiction reasoning calls
GROQ_MODEL=openai/gpt-oss-120b

# Hugging Face token — free, get one at https://huggingface.co/settings/tokens
# (needs at least "read" access; used for the hosted embeddings API)
HF_TOKEN=your_huggingface_token_here

# Embedding model, called via the HF Inference API (no local PyTorch needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# SQLite path
MEMORY_DB_PATH=./data/memory.db
